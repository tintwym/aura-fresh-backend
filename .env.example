# Neon PostgreSQL — copy from Neon dashboard → Connect
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_ADMIN_BASE_URL=http://localhost:3001

# Cloudinary — product images
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=aura-fresh/products

# AI features (Smart Recipes for web + iOS) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# Comma-separated, tried in order when the main model is busy or rate-limited
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest

# Optional — first admin account (only created if username does not exist)
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_PASSWORD=change-me-strong-password

# Optional — Stripe return URLs
# Web:
# APP_CHECKOUT_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
# APP_CHECKOUT_CANCEL_URL=http://localhost:3000/cart
# iOS (Aura Fresh):
# APP_CHECKOUT_SUCCESS_URL=aurafresh://payment/success?session_id={CHECKOUT_SESSION_ID}
# APP_CHECKOUT_CANCEL_URL=aurafresh://cart

# Social sign-in (ID token verification)
# Google Cloud Console → OAuth 2.0 Web client ID (required for web Google Sign-In)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Optional comma-separated extra audiences (e.g. iOS client ID)
# GOOGLE_CLIENT_IDS=xxxxx-ios.apps.googleusercontent.com
# Apple Sign in with Apple — Services ID and/or iOS bundle id (token aud)
# APPLE_CLIENT_ID=dev.tintwym.shopping-cart-ios
# APPLE_CLIENT_IDS=
